# Johansen et al. (2007) Run BA: nonlinear streaming instability in a 2.5-D
# radial-vertical box. Lengths are in code units with Omega=cs=rho_g=1 and
# eta*v_K=0.05, so eta*r=0.05 and a 40 eta*r box has length 2.

<comment>
problem = Johansen et al. (2007) Run BA

<job>
basename = streaming_BA

<mesh>
nghost = 3
nx1 = 256
x1min = -1.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 256
x2min = -1.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 1

<time>
evolution = dynamic
integrator = imex2+
cfl_number = 0.3
nlim = -1
tlim = 160.0
ndiag = 10000

<hydro>
eos = isothermal
iso_sound_speed = 1.0
reconstruct = ppmx
rsolver = roe

<hydro_srcterms>
const_accel = true
const_accel_val = 0.1
const_accel_dir = 1

<shearing_box>
qshear = 1.5
omega0 = 1.0

<particles>
particle_type = dust
pusher = imex_dust
ppc = 25.0

<dust>
nspecies = 1
taus_1 = 1.0
dust_to_gas = 0.2
back_reaction = true
deposit = tsc
gamma_switch = false
dt_cfl = 0.5

<problem>
pgen_name = dust_nsh
user_hist = true
rho0 = 1.0
etavk = 0.05
eps_1 = 0.2
particle_placement = random
random_seed = 2007
check_equilibrium = false

<output1>
file_type = hst
dt = 0.1
data_format = %.14e

# Particle positions at t=0,40,80,120,160. The Figure 2 density field is
# reconstructed from these snapshots with periodic TSC assignment. A restart output is
# intentionally omitted because the current AthenaK restart format does not store particles.
<output2>
file_type = pvtk
variable = prtcl_all
dt = 40.0
