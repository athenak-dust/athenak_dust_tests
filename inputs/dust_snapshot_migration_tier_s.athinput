# Tier-S coherent migration-stress benchmark.
#
# It uses exactly the same deterministic BA2 particle positions as the clump pair, but
# gas and dust start with the same +x1 velocity.  There is initially no drag transient;
# the common flow repeatedly carries the clump across MeshBlock/MPI and periodic domain
# boundaries.  This isolates migration/packing overhead from stiff-solver iteration cost.

<comment>
problem = Tier-S coherent migration of snapshot-seeded clump

<job>
basename = dust_snapshot_migration_tier_s

<mesh>
nghost = 3
nx1 = 64
x1min = -1.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 64
x2min = -1.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 1

<time>
evolution = dynamic
integrator = imex2+
cfl_number = 0.45
dtmax = 0.01
nlim = 2000
tlim = 1.0e30
ndiag = 500

<hydro>
eos = isothermal
iso_sound_speed = 1.0
reconstruct = plm
rsolver = roe

<particles>
particle_type = dust
pusher = imex_dust
ppc = 16.0

<dust>
nspecies = 1
taus_1 = 1.0e-1
dust_to_gas = 1.0
back_reaction = true
deposit = tsc
gamma_switch = false
stopping_time_mode = species_fixed
dt_cfl = 0.5
drag_solver = local
drag_rtol = 1.0e-11
drag_atol = 1.0e-14
drag_iter_max = 200
drag_fail_policy = abort
drag_diagnostic_interval = 0

<problem>
snapshot_file = BA2.prtcl_all.00121.part.vtk
snapshot_x1min = -1.0
snapshot_x1max = 1.0
snapshot_x2min = -1.0
snapshot_x2max = 1.0
snapshot_seed = 20260720
user_hist = true
rho0 = 1.0
eps_1 = 1.0
gas_vx = 5.0
gas_vy = 0.0
gas_vz = 0.0
slip_vx = 0.0
slip_vy = 0.0
slip_vz = 0.0
velocity_mode = uniform

<output1>
file_type = hst
dcycle = 100000
data_format = %.14e
