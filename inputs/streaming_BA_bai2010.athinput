# Bai & Stone (2010) Run BA convergence template. The default values are BA3;
# override the job name, mesh resolution, and MeshBlock size for BA1/BA2.
# PDFs are accumulated offline from periodic particle snapshots over t=300--1500.

<comment>
problem = Bai and Stone (2010) Run BA convergence

<job>
basename = BA3

<mesh>
nghost = 3
nx1 = 256
x1min = -1.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 256
x2min = -1.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 1

<time>
evolution = dynamic
integrator = imex2+
cfl_number = 0.3
nlim = -1
tlim = 1500.0
ndiag = 10000

<hydro>
eos = isothermal
iso_sound_speed = 1.0
reconstruct = ppmx
rsolver = roe

<hydro_srcterms>
const_accel = true
const_accel_val = 0.1
const_accel_dir = 1

<shearing_box>
qshear = 1.5
omega0 = 1.0

<particles>
particle_type = dust
pusher = imex_dust
ppc = 9.0

<dust>
nspecies = 1
taus_1 = 1.0
dust_to_gas = 0.2
back_reaction = true
deposit = tsc
gamma_switch = false
dt_cfl = 0.5

<problem>
pgen_name = dust_nsh
user_hist = true
rho0 = 1.0
etavk = 0.05
eps_1 = 0.2
particle_placement = random
random_seed = 2007
check_equilibrium = false

<output1>
file_type = hst
dt = 0.1
data_format = %.14e

# Initialization always writes one t=0 snapshot. Starting with last_time=280 then
# schedules the analysis snapshots at t=300,310,...,1500.
<output2>
file_type = pvtk
variable = prtcl_all
dt = 10.0
last_time = 280.0
